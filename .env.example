# Copy to .env and fill in. These feed config.yaml via ${VAR} interpolation.
# This project NEVER reaches the public internet; the only network call is to
# the local LLM endpoint below.

# ----- Local LLM (OpenAI-compatible) -----
# Base URL of your local-network LLM, OpenAI format. MUST end in /v1 for most servers.
LLM_BASE_URL=http://your-local-llm:8000/v1
# API key (may be a placeholder if your gateway authenticates via headers instead).
LLM_API_KEY=not-needed-if-using-headers
# Model name as your endpoint expects it.
LLM_MODEL=your-chat-model

# ----- Custom headers (the reason stock GraphRAG alone is not enough) -----
# Add as many as you need. They are sent on EVERY LLM call.
LLM_HEADER_1_NAME=Authorization
LLM_HEADER_1_VALUE=Bearer your-token
LLM_HEADER_2_NAME=
LLM_HEADER_2_VALUE=

# ----- Local embedding model (HuggingFace, on disk, safetensors) -----
# Absolute path to the model directory (contains config.json + *.safetensors + tokenizer).
EMBED_MODEL_PATH=/abs/path/to/hf-embedding-model
# Embedding dimension of that model (e.g. 768, 1024).
EMBED_DIM=1024
# cpu or cuda
EMBED_DEVICE=cpu

# ----- Docling offline model artifacts -----
# Directory produced by scripts/prefetch_docling_models.py on an online machine.
DOCLING_ARTIFACTS=/abs/path/to/docling_models

# ----- Offline tokenizer cache (tiktoken) -----
# Directory holding the pre-downloaded tiktoken encoding files.
TIKTOKEN_CACHE_DIR=/abs/path/to/tiktoken_cache
